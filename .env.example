# Sao chep file nay thanh .env roi dien gia tri that. KHONG commit file .env.

# Cong chay API
PORT=4000

# Chuoi ket noi MongoDB (Atlas hoac local). Vi du:
#   Local : mongodb://localhost:27017/hsu_shoe_shop
#   Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hsu_shoe_shop?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/hsu_shoe_shop

# Origin frontend duoc phep goi API (CORS). Nhieu origin cach nhau boi dau phay.
CORS_ORIGIN=http://localhost:5173

# --- Xac thuc (P01) ---
# Chuoi bi mat ky JWT, >= 32 ky tu. Tao nhanh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# Thoi han token (vi du 1h, 8h, 7d)
JWT_EXPIRES_IN=8h
# Do manh bam mat khau (bcrypt cost, 10-12)
BCRYPT_COST=10
# Chi dung cho `npm run seed` (dev/test): mat khau chung cua tai khoan demo
SEED_PASSWORD=Demo@12345

# (Tuy chon) DB rieng cho integration test. Ten DB phai chua chu "test". De trong -> dung MongoDB in-memory.
# MONGODB_URI_TEST=mongodb://localhost:27017/hsu_test
